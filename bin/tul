#!/usr/bin/env python3
"""
tul — Terminal Update Loop

Initial CLI v0.2 with branch guard support.

Primary goal:
  Make the LLM-user-terminal-GitHub-LLM loop fast enough for humtr/ai,
  while remaining useful for humtr/tul and other repos.

Important:
  - update is the default full-loop command.
  - publish is the commit+push half of update.
  - sweep moves artifacts out of the repo; it does not delete by default.
  - rollback uses revert+push, not force-push.
"""

from __future__ import annotations

import argparse
import datetime as _dt
import fnmatch
import hashlib
import os
import shutil
import subprocess
import sys
import tarfile
import zipfile
from dataclasses import dataclass
from pathlib import Path
from typing import Iterable, Sequence


class TulError(Exception):
    pass


def eprint(*args: object) -> None:
    print(*args, file=sys.stderr)


def say(msg: str = "") -> None:
    print(msg)


def is_windows() -> bool:
    return os.name == "nt"


def home() -> Path:
    return Path.home()


def now_stamp() -> str:
    return _dt.datetime.now().strftime("%Y%m%d-%H%M%S")


def run(
    args: Sequence[str],
    cwd: Path | None = None,
    check: bool = True,
    capture: bool = False,
    text: bool = True,
) -> subprocess.CompletedProcess[str]:
    if capture:
      return subprocess.run(args, cwd=str(cwd) if cwd else None, check=check, text=text, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    return subprocess.run(args, cwd=str(cwd) if cwd else None, check=check, text=text)


def run_out(args: Sequence[str], cwd: Path | None = None, check: bool = True) -> str:
    cp = run(args, cwd=cwd, check=check, capture=True)
    return cp.stdout.strip()


def git(repo: Path, *args: str, check: bool = True, capture: bool = False) -> subprocess.CompletedProcess[str]:
    return run(["git", *args], cwd=repo, check=check, capture=capture)


def git_out(repo: Path, *args: str, check: bool = True) -> str:
    return run_out(["git", *args], cwd=repo, check=check)


def repo_root(path: str | Path) -> Path:
    p = Path(path).expanduser()
    if not p.exists():
        raise TulError(f"repo path does not exist: {p}")
    root = run_out(["git", "-C", str(p), "rev-parse", "--show-toplevel"])
    return Path(root)


def rel_norm(path: str | Path) -> str:
    return str(path).replace("\\", "/")


def branch(repo: Path) -> str:
    return git_out(repo, "branch", "--show-current")


def head(repo: Path, short: bool = False) -> str:
    if short:
        return git_out(repo, "rev-parse", "--short", "HEAD")
    return git_out(repo, "rev-parse", "HEAD")


def upstream(repo: Path) -> str | None:
    try:
        value = git_out(repo, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
        return value or None
    except subprocess.CalledProcessError:
        return None


def porcelain(repo: Path) -> list[str]:
    out = git_out(repo, "status", "--porcelain", check=True)
    return [line for line in out.splitlines() if line.strip()]


def changed_tracked(repo: Path) -> list[str]:
    out = git_out(repo, "diff", "--name-only")
    return [rel_norm(x.strip()) for x in out.splitlines() if x.strip()]


def staged_names(repo: Path) -> list[str]:
    out = git_out(repo, "diff", "--cached", "--name-only")
    return [rel_norm(x.strip()) for x in out.splitlines() if x.strip()]


def untracked(repo: Path) -> list[str]:
    out = git_out(repo, "ls-files", "--others", "--exclude-standard")
    return [rel_norm(x.strip()) for x in out.splitlines() if x.strip()]


def ensure_git_clean_for_sync(repo: Path) -> None:
    status = porcelain(repo)
    if status:
        say("Working tree is not clean:")
        for line in status:
            say(f"  {line}")
        raise TulError("sync aborted: commit, publish, stash, or restore local changes first.")


def rev_exists(repo: Path, rev: str) -> bool:
    cp = git(repo, "rev-parse", "--verify", rev, check=False, capture=True)
    return cp.returncode == 0


def compare_upstream(repo: Path) -> tuple[int, int] | None:
    up = upstream(repo)
    if not up:
        return None
    out = git_out(repo, "rev-list", "--left-right", "--count", f"HEAD...{up}")
    left, right = out.split()
    return int(left), int(right)


def read_tul_config(repo: Path) -> dict[str, str]:
    """Read a tiny top-level subset of .tul.yml without external dependencies.

    Supported top-level keys:
      name, repo, branch, expected_branch, default_branch

    This is intentionally small for v0.2. A later version can use a YAML parser.
    """
    path = repo / ".tul.yml"
    cfg: dict[str, str] = {}
    if not path.exists():
        return cfg

    allowed = {"name", "repo", "branch", "expected_branch", "default_branch"}
    for raw in path.read_text(encoding="utf-8").splitlines():
        # Strip comments, but keep simple quoted values usable enough for v0.2.
        line = raw.split("#", 1)[0].strip()
        if not line or line.startswith("-") or ":" not in line:
            continue
        key, value = line.split(":", 1)
        key = key.strip()
        value = value.strip().strip('"').strip("'")
        if key in allowed and value:
            cfg[key] = value
    return cfg


def project_id(repo: Path) -> str:
    cfg = read_tul_config(repo)
    return cfg.get("name") or repo.name


def configured_repo_slug(repo: Path) -> str | None:
    return read_tul_config(repo).get("repo")


def expected_branch(repo: Path) -> str | None:
    cfg = read_tul_config(repo)
    return cfg.get("branch") or cfg.get("expected_branch") or cfg.get("default_branch")


def branch_mismatch(repo: Path) -> tuple[str, str] | None:
    expected = expected_branch(repo)
    if not expected:
        return None
    current = branch(repo)
    if current != expected:
        return current, expected
    return None


def require_expected_branch(repo: Path, allow_mismatch: bool = False) -> None:
    mismatch = branch_mismatch(repo)
    if not mismatch or allow_mismatch:
        return
    current, expected = mismatch
    raise TulError(
        "branch mismatch: "
        f"current branch is {current!r}, expected {expected!r}. "
        f"Run: git switch {expected}"
    )


def show_branch_expectation(repo: Path) -> None:
    expected = expected_branch(repo)
    if not expected:
        return
    current = branch(repo)
    say(f"expected : {expected}")
    if current != expected:
        say(f"WARNING  : branch mismatch; current {current}, expected {expected}")


def windows_downloads_root() -> Path:
    # Primary user convention.
    p = Path(r"D:\work\files\downloads")
    if p.exists():
        return p
    # Fallback to profile Downloads.
    return Path(os.environ.get("USERPROFILE", str(home()))) / "Downloads"


def termux_downloads_root() -> Path:
    return Path("/sdcard/Download")


def work_root_for_platform() -> Path:
    if is_windows():
        return windows_downloads_root() / ".tul" / "work"
    return Path("/sdcard/termux/import/tul/work")


def archive_root_for_platform() -> Path:
    if is_windows():
        return windows_downloads_root() / ".tul" / "archive"
    return Path("/sdcard/termux/import/tul/archive")


def backup_root_for_platform(project: str) -> Path:
    if is_windows():
        return Path(r"D:\work\var\backup\tul") / project / now_stamp()
    return home() / "tmp" / "tul-backups" / project / now_stamp()


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def candidate_packages(downloads: Path) -> list[Path]:
    if not downloads.exists():
        return []
    pats = ("*.zip", "*.tar.gz", "*.tgz")
    items: list[Path] = []
    for pat in pats:
        items.extend(downloads.glob(pat))
    return sorted(items, key=lambda p: p.stat().st_mtime, reverse=True)


def package_id(path: Path) -> str:
    name = path.name
    for suffix in (".tar.gz", ".tgz", ".zip"):
        if name.endswith(suffix):
            name = name[: -len(suffix)]
            break
    safe = "".join(ch if ch.isalnum() or ch in ("-", "_", ".") else "-" for ch in name)
    return f"{safe}-{now_stamp()}"


def extract_archive(src: Path, dest: Path) -> None:
    dest.mkdir(parents=True, exist_ok=True)
    if src.name.endswith(".zip"):
        with zipfile.ZipFile(src) as z:
            z.extractall(dest)
    elif src.name.endswith(".tar.gz") or src.name.endswith(".tgz"):
        with tarfile.open(src) as t:
            t.extractall(dest)
    else:
        raise TulError(f"unsupported archive type: {src}")


def find_apply_scripts(root: Path) -> list[Path]:
    candidates: list[Path] = []
    patterns = [
        "apply.ps1", "apply.sh",
        "apply*.ps1", "apply*.sh",
        "install*.ps1", "install*.sh",
        "*patch*.py",
    ]
    for path in root.rglob("*"):
        if not path.is_file():
            continue
        name = path.name
        for pat in patterns:
            if fnmatch.fnmatch(name, pat):
                candidates.append(path)
                break
    return candidates


def import_package(which: str = "latest", src_path: str | None = None) -> Path:
    if src_path:
        src = Path(src_path).expanduser()
    elif which == "latest":
        downloads = windows_downloads_root() if is_windows() else termux_downloads_root()
        pkgs = candidate_packages(downloads)
        if not pkgs:
            raise TulError(f"no package found in {downloads}")
        src = pkgs[0]
    else:
        src = Path(which).expanduser()

    if not src.exists():
        raise TulError(f"package not found: {src}")

    pid = package_id(src)
    work = work_root_for_platform() / pid
    extracted = work / "extracted"
    work.mkdir(parents=True, exist_ok=True)

    copied = work / src.name
    shutil.copy2(src, copied)
    extract_archive(copied, extracted)

    meta = {
        "source": str(src),
        "copied": str(copied),
        "sha256": sha256_file(copied),
        "package_id": pid,
        "extracted": str(extracted),
        "created_at": _dt.datetime.now().isoformat(timespec="seconds"),
    }
    (work / "tul-import.json").write_text(__import__("json").dumps(meta, indent=2), encoding="utf-8")

    say(f"Imported package: {src}")
    say(f"Work dir        : {work}")
    say(f"Extracted       : {extracted}")
    say(f"SHA256          : {meta['sha256']}")

    scripts = find_apply_scripts(extracted)
    if scripts:
        say("Apply script candidates:")
        for script in scripts:
            say(f"  {script}")
    else:
        say("No apply script candidates found.")

    return work


def latest_work_dir() -> Path | None:
    root = work_root_for_platform()
    if not root.exists():
        return None
    dirs = [p for p in root.iterdir() if p.is_dir()]
    if not dirs:
        return None
    return sorted(dirs, key=lambda p: p.stat().st_mtime, reverse=True)[0]


def run_apply_script(repo: Path, work: Path, yes: bool = False) -> None:
    extracted = work / "extracted"
    scripts = find_apply_scripts(extracted)
    if not scripts:
        raise TulError(f"no apply script found under {extracted}")
    script = scripts[0]
    say(f"Selected apply script: {script}")
    say(f"Target repo          : {repo}")
    if not yes:
        answer = input("Run this apply script? [y/N] ").strip().lower()
        if answer not in ("y", "yes"):
            raise TulError("apply cancelled by user")

    if script.suffix.lower() == ".ps1":
        if not is_windows():
            raise TulError("PowerShell apply scripts are only supported on Windows in this v0.1 CLI")
        run(["powershell.exe", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", str(script), "-Repo", str(repo)], check=True)
    elif script.suffix.lower() == ".sh":
        run(["bash", str(script), str(repo)], check=True)
    elif script.suffix.lower() == ".py":
        run([sys.executable, str(script), str(repo)], check=True)
    else:
        raise TulError(f"unsupported apply script: {script}")


def cmd_status(args: argparse.Namespace) -> None:
    repo = repo_root(args.repo)
    say(f"repo     : {repo}")
    say(f"project  : {project_id(repo)}")
    configured = configured_repo_slug(repo)
    if configured:
        say(f"config   : {configured}")
    say(f"branch   : {branch(repo)}")
    show_branch_expectation(repo)
    say(f"HEAD     : {head(repo, short=True)}")
    up = upstream(repo)
    say(f"upstream : {up or '(none)'}")
    comp = compare_upstream(repo) if up else None
    if comp:
        ahead, behind = comp
        say(f"remote   : ahead {ahead}, behind {behind}")
    status = porcelain(repo)
    say("status   : clean" if not status else "status   : dirty")
    for line in status:
        say(f"  {line}")


def cmd_sync(args: argparse.Namespace) -> None:
    repo = repo_root(args.repo)
    require_expected_branch(repo, allow_mismatch=getattr(args, "allow_branch_mismatch", False))
    ensure_git_clean_for_sync(repo)
    b = branch(repo)
    say(f"Fetching origin for {repo}...")
    git(repo, "fetch", "origin")
    up = upstream(repo)
    if not up:
        say("No upstream configured; sync cannot pull.")
        return
    comp = compare_upstream(repo)
    if comp is None:
        return
    ahead, behind = comp
    if ahead == 0 and behind == 0:
        say(f"Already up to date with {up}.")
    elif ahead == 0 and behind > 0:
        say(f"Pulling {behind} commit(s) from {up} with --ff-only...")
        git(repo, "pull", "--ff-only")
    elif ahead > 0 and behind == 0:
        say(f"Local branch is ahead of {up} by {ahead} commit(s). Run tul publish/update or git push.")
    else:
        raise TulError(f"branch diverged from {up}: ahead {ahead}, behind {behind}")


def fallback_checks(repo: Path, keep_going: bool = False) -> int:
    failures = 0

    def step(label: str, cmd: list[str]) -> None:
        nonlocal failures
        say(f"== {label} ==")
        cp = run(cmd, cwd=repo, check=False)
        if cp.returncode != 0:
            failures += 1
            if not keep_going:
                raise TulError(f"check failed: {label}")

    step("git diff --check", ["git", "diff", "--check"])

    # Light auto-detection. Missing tools are skipped.
    if (repo / "lib").exists():
        py_files = list((repo / "lib").glob("*.py"))
        if py_files:
            step("python -m py_compile lib/*.py", [sys.executable, "-m", "py_compile", *[str(p) for p in py_files]])

    bin_ai = repo / "bin" / "ai"
    if bin_ai.exists() and shutil.which("bash"):
        step("bash -n bin/ai", ["bash", "-n", str(bin_ai)])

    scripts = list((repo / "scripts").glob("*.sh")) if (repo / "scripts").exists() else []
    if scripts and shutil.which("bash"):
        step("bash -n scripts/*.sh", ["bash", "-n", *[str(p) for p in scripts]])

    # Project-specific forbidden pattern checks belong in .tul.yml.
    # Do not hardcode humtr/ai-specific forbidden strings globally.


    return failures


def cmd_check(args: argparse.Namespace) -> None:
    repo = repo_root(args.repo)
    failures = fallback_checks(repo, keep_going=args.keep_going)
    if failures:
        raise TulError(f"{failures} check(s) failed")
    say("Checks passed.")


def sweep_repo(repo: Path) -> Path | None:
    proj = project_id(repo)
    dest = backup_root_for_platform(proj)
    moved: list[Path] = []

    root_patterns = [
        ".tul-*-backup-*",
        ".tul-doc-format-backup-*",
        ".tul-downloads-staging-backup-*",
        ".tul-update-command-model-backup-*",
    ]

    for pat in root_patterns:
        for item in repo.glob(pat):
            if item.exists():
                dest.mkdir(parents=True, exist_ok=True)
                target = dest / item.name
                shutil.move(str(item), str(target))
                moved.append(target)

    # Conservative: only root-level known files, not arbitrary recursive deletion.
    file_patterns = ["*.stage*.bak", "*_stage*.diff", "*.tmp"]
    for pat in file_patterns:
        for item in repo.glob(pat):
            if item.is_file():
                dest.mkdir(parents=True, exist_ok=True)
                target = dest / item.name
                shutil.move(str(item), str(target))
                moved.append(target)

    if moved:
        say(f"Moved {len(moved)} artifact(s) to {dest}:")
        for item in moved:
            say(f"  {item}")
        return dest

    say("No repo-local tul artifacts to sweep.")
    return None


def cmd_sweep(args: argparse.Namespace) -> None:
    repo = repo_root(args.repo)
    sweep_repo(repo)


def ensure_only_intended_changes(repo: Path, files: list[str]) -> None:
    allowed = {rel_norm(f) for f in files}

    unexpected_tracked = [p for p in changed_tracked(repo) if p not in allowed]
    if unexpected_tracked:
        say("Unexpected tracked changes:")
        for p in unexpected_tracked:
            say(f"  {p}")
        raise TulError("abort: unexpected tracked files changed")

    untracked_items = untracked(repo)
    unexpected_untracked = [p for p in untracked_items if p not in allowed]
    if unexpected_untracked:
        say("Unexpected untracked files:")
        for p in unexpected_untracked:
            say(f"  {p}")
        raise TulError("abort: unexpected untracked files; sweep or remove them first")


def publish(
    repo: Path,
    files: list[str],
    message: str,
    no_push: bool = False,
    keep_going: bool = False,
    allow_branch_mismatch: bool = False,
) -> None:
    require_expected_branch(repo, allow_mismatch=allow_branch_mismatch)

    if not files:
        raise TulError("publish requires explicit --files")
    if not message:
        raise TulError("publish requires --message")

    b = branch(repo)

    say("== sweep ==")
    sweep_repo(repo)

    say("== check working tree ==")
    fallback_checks(repo, keep_going=keep_going)

    say("== verify intended files ==")
    for f in files:
        if not (repo / f).exists():
            # File may be deletion; allow if tracked before.
            cp = git(repo, "ls-files", "--error-unmatch", f, check=False, capture=True)
            if cp.returncode != 0:
                raise TulError(f"intended file does not exist and is not tracked: {f}")

    ensure_only_intended_changes(repo, files)

    say("== diff stat ==")
    git(repo, "diff", "--stat")

    say("== stage explicit files only ==")
    git(repo, "add", "--", *files)

    say("== staged check ==")
    git(repo, "diff", "--cached", "--check")
    git(repo, "diff", "--cached", "--stat")

    staged = staged_names(repo)
    allowed = {rel_norm(f) for f in files}
    unexpected_staged = [p for p in staged if p not in allowed]
    if unexpected_staged:
        say("Unexpected staged files:")
        for p in unexpected_staged:
            say(f"  {p}")
        raise TulError("abort: unexpected staged files")

    if not staged:
        say("No staged changes to commit.")
        return

    say("== commit ==")
    git(repo, "commit", "-m", message)
    commit_hash = head(repo, short=False)
    commit_short = head(repo, short=True)

    if no_push:
        say(f"Committed but not pushed: {commit_short} {message}")
        say(f"Push later with: git push origin {b}")
        return

    say("== push ==")
    git(repo, "push", "origin", b)

    say("== remote verification ==")
    git(repo, "fetch", "origin", b)
    local = git_out(repo, "rev-parse", "HEAD")
    remote = git_out(repo, "rev-parse", f"origin/{b}")
    say(f"local HEAD : {local}")
    say(f"remote HEAD: {remote}")
    if local != remote:
        raise TulError(f"push verification failed: local HEAD != origin/{b}")

    say("Push verified: local HEAD matches remote branch.")
    say("")
    say("Rollback if needed:")
    say(f"  git revert {commit_short}")
    say(f"  git push origin {b}")


def cmd_publish(args: argparse.Namespace) -> None:
    repo = repo_root(args.repo)
    publish(
        repo,
        args.files or [],
        args.message or "",
        no_push=args.no_push,
        keep_going=args.keep_going,
        allow_branch_mismatch=getattr(args, "allow_branch_mismatch", False),
    )


def cmd_report(args: argparse.Namespace) -> None:
    repo = repo_root(args.repo)
    say("# tul report")
    say("")
    say(f"Repo: {repo}")
    say(f"Project: {project_id(repo)}")
    configured = configured_repo_slug(repo)
    if configured:
        say(f"Configured repo: {configured}")
    say(f"Platform: {'windows' if is_windows() else 'termux-or-posix'}")
    say(f"Branch: {branch(repo)}")
    expected = expected_branch(repo)
    if expected:
        say(f"Expected branch: {expected}")
        if branch(repo) != expected:
            say("Branch warning: mismatch")
    say(f"HEAD: {head(repo, short=True)}")
    say(f"Upstream: {upstream(repo) or '(none)'}")
    comp = compare_upstream(repo) if upstream(repo) else None
    if comp:
        ahead, behind = comp
        say(f"Remote state: ahead {ahead}, behind {behind}")
    say("")
    say("Status:")
    st = porcelain(repo)
    if st:
        for line in st:
            say(f"  {line}")
    else:
        say("  clean")
    say("")
    say("Diff stat:")
    cp = git(repo, "diff", "--stat", check=False, capture=True)
    say(cp.stdout.rstrip() or "  (no unstaged diff)")
    say("")
    say("Recent commits:")
    cp = git(repo, "log", "--oneline", "--decorate", "-5", check=False, capture=True)
    say(cp.stdout.rstrip())


def cmd_import(args: argparse.Namespace) -> None:
    import_package(which=args.which or "latest", src_path=args.path)


def cmd_apply(args: argparse.Namespace) -> None:
    repo = repo_root(args.repo)
    require_expected_branch(repo, allow_mismatch=getattr(args, "allow_branch_mismatch", False))
    work = Path(args.work).expanduser() if args.work else latest_work_dir()
    if work is None:
        raise TulError("no tul work directory found; run tul import first")
    run_apply_script(repo, work, yes=args.yes)


def cmd_update(args: argparse.Namespace) -> None:
    repo = repo_root(args.repo)
    require_expected_branch(repo, allow_mismatch=getattr(args, "allow_branch_mismatch", False))

    if not args.skip_sync:
        # sync only when clean; if package is applying to clean repo this is ideal.
        if porcelain(repo):
            say("Pre-sync skipped because working tree is dirty. Continuing only if this is an intentional local update.")
        else:
            cmd_sync(argparse.Namespace(repo=str(repo)))

    if args.package or args.latest:
        work = import_package(which=args.package or "latest")
        run_apply_script(repo, work, yes=args.yes)
        say("== check after apply ==")
        fallback_checks(repo, keep_going=args.keep_going)

    if args.no_commit:
        say("Stopping before commit because --no-commit was provided.")
        cmd_report(argparse.Namespace(repo=str(repo)))
        return

    if args.files and args.message:
        publish(
            repo,
            args.files,
            args.message,
            no_push=args.no_push,
            keep_going=args.keep_going,
            allow_branch_mismatch=getattr(args, "allow_branch_mismatch", False),
        )
        cmd_report(argparse.Namespace(repo=str(repo)))
        return

    say("No commit metadata provided.")
    say("Provide --files and --message, or use a future tul-package.yml manifest.")
    cmd_report(argparse.Namespace(repo=str(repo)))
    raise TulError("update stopped before commit: missing --files/--message")


def cmd_rollback(args: argparse.Namespace) -> None:
    repo = repo_root(args.repo)
    require_expected_branch(repo, allow_mismatch=getattr(args, "allow_branch_mismatch", False))
    b = branch(repo)
    commit = args.commit or "HEAD"
    say(f"Reverting {commit} in {repo}")
    git(repo, "revert", commit)
    if args.no_push:
        say("Rollback commit created but not pushed because --no-push was provided.")
        return
    git(repo, "push", "origin", b)
    git(repo, "fetch", "origin", b)
    local = git_out(repo, "rev-parse", "HEAD")
    remote = git_out(repo, "rev-parse", f"origin/{b}")
    if local != remote:
        raise TulError(f"rollback push verification failed: local HEAD != origin/{b}")
    say("Rollback pushed and verified.")


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="tul", description="Terminal Update Loop")
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("status", help="show short repo status")
    sp.add_argument("repo")
    sp.set_defaults(func=cmd_status)

    sp = sub.add_parser("sync", help="fetch/pull --ff-only when safe")
    sp.add_argument("repo")
    sp.add_argument("--allow-branch-mismatch", action="store_true")
    sp.set_defaults(func=cmd_sync)

    sp = sub.add_parser("check", help="run repo checks")
    sp.add_argument("repo")
    sp.add_argument("--keep-going", action="store_true")
    sp.set_defaults(func=cmd_check)

    sp = sub.add_parser("verify", help="alias for check")
    sp.add_argument("repo")
    sp.add_argument("--keep-going", action="store_true")
    sp.set_defaults(func=cmd_check)

    sp = sub.add_parser("sweep", help="move repo-local tul artifacts out of repo")
    sp.add_argument("repo")
    sp.set_defaults(func=cmd_sweep)

    sp = sub.add_parser("report", help="print LLM-ready repo report")
    sp.add_argument("repo")
    sp.set_defaults(func=cmd_report)

    sp = sub.add_parser("import", help="import package into tul work root")
    sp.add_argument("which", nargs="?", default="latest")
    sp.add_argument("--path")
    sp.set_defaults(func=cmd_import)

    sp = sub.add_parser("apply", help="apply latest/staged package to repo")
    sp.add_argument("repo")
    sp.add_argument("--work")
    sp.add_argument("-y", "--yes", action="store_true")
    sp.add_argument("--allow-branch-mismatch", action="store_true")
    sp.set_defaults(func=cmd_apply)

    sp = sub.add_parser("publish", help="sweep, check, commit, push, verify remote")
    sp.add_argument("repo")
    sp.add_argument("--files", nargs="+", required=True)
    sp.add_argument("--message", required=True)
    sp.add_argument("--no-push", action="store_true")
    sp.add_argument("--keep-going", action="store_true")
    sp.add_argument("--allow-branch-mismatch", action="store_true")
    sp.set_defaults(func=cmd_publish)

    sp = sub.add_parser("update", help="default full-loop command")
    sp.add_argument("repo")
    sp.add_argument("--package", help="package path or 'latest'")
    sp.add_argument("--latest", action="store_true", help="import latest package")
    sp.add_argument("--files", nargs="+")
    sp.add_argument("--message")
    sp.add_argument("--no-commit", action="store_true")
    sp.add_argument("--no-push", action="store_true")
    sp.add_argument("--skip-sync", action="store_true")
    sp.add_argument("--keep-going", action="store_true")
    sp.add_argument("--allow-branch-mismatch", action="store_true")
    sp.add_argument("-y", "--yes", action="store_true", help="confirm apply script execution")
    sp.set_defaults(func=cmd_update)

    sp = sub.add_parser("rollback", help="revert a commit and push")
    sp.add_argument("repo")
    sp.add_argument("--commit", default="HEAD")
    sp.add_argument("--no-push", action="store_true")
    sp.add_argument("--allow-branch-mismatch", action="store_true")
    sp.set_defaults(func=cmd_rollback)

    return p


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        args.func(args)
        return 0
    except TulError as exc:
        eprint(f"ERROR: {exc}")
        return 2
    except subprocess.CalledProcessError as exc:
        eprint(f"ERROR: command failed with exit code {exc.returncode}: {' '.join(exc.cmd) if isinstance(exc.cmd, list) else exc.cmd}")
        if getattr(exc, "stdout", None):
            eprint(exc.stdout)
        if getattr(exc, "stderr", None):
            eprint(exc.stderr)
        return exc.returncode or 1


if __name__ == "__main__":
    raise SystemExit(main())
