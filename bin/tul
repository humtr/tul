#!/usr/bin/env python3
from __future__ import annotations

import os
import sys
from pathlib import Path


def _bootstrap() -> None:
    here = Path(__file__).resolve()
    candidates = []
    if os.environ.get("TUL_LIB_DIR"):
        candidates.append(Path(os.environ["TUL_LIB_DIR"]).expanduser())
    candidates.append(here.parent.parent / "lib")
    candidates.append(Path.home() / ".config" / "tul" / "lib")

    for candidate in candidates:
        if (candidate / "tulcore" / "__init__.py").exists():
            sys.path.insert(0, str(candidate))
            return


_bootstrap()

from tulcore.cli import main

raise SystemExit(main())
